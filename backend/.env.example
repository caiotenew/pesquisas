# Supabase: use a string "Session pooler" (porta 5432) nas DUAS variáveis (funciona no Render, que só tem IPv4).
# Copie do painel: Connect > Session pooler. Se a senha tiver símbolos (@ # / : ?), codifique-os (ex.: @ vira %40).
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
JWT_SECRET="troque-esta-chave-por-uma-chave-grande-e-aleatoria"
PORT=3000
ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,https://caiotenew.github.io"
METABASE_DASHBOARD_URL=""

# Administrador principal (a única conta com perfil ADMIN).
ADMIN_EMAIL="damascenocaio311@gmail.com"
ADMIN_NAME="Caio Damasceno"
# Se ficar vazio, a senha inicial é 1234 (troque no primeiro acesso, em "Alterar senha").
ADMIN_PASSWORD="1234"
# O seed NÃO sobrescreve a senha que você escolher depois. Só use "true" para forçar o retorno à ADMIN_PASSWORD.
ADMIN_RESET_PASSWORD="false"
